{
  "name": "kikbul",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:links": "playwright test e2e/broken-links.spec.ts",
    "test:e2e:visual": "playwright test e2e/visual-regression.spec.ts",
    "test:e2e:visual:update": "playwright test e2e/visual-regression.spec.ts --update-snapshots",
    "test:e2e:prod": "BASE_URL=http://178.104.96.83:8080 playwright test",
    "production:check": "ts-node scripts/production-check.ts",
    "migrate:dry-run": "ts-node scripts/migrate-to-real-data.ts --dry-run",
    "migrate:execute": "ts-node scripts/migrate-to-real-data.ts --execute",
    "migrate:rollback": "ts-node scripts/migrate-to-real-data.ts --rollback",
    "load-test": "k6 run k6/load-test.js",
    "ekap:initial-sync": "npx tsx scripts/initial-ekap-sync.ts --resume",
    "ekap:initial-sync:full": "npx tsx scripts/initial-ekap-sync.ts --from=2021 --to=2026",
    "ekap:sync": "npx tsx scripts/ekap-sync-playwright.ts --resume",
    "ekap:sync:full": "npx tsx scripts/ekap-sync-playwright.ts --from=2021 --to=2026",
    "ekap:sync:headed": "npx tsx scripts/ekap-sync-playwright.ts --resume --headed",
    "ekap:native": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx tsx scripts/ekap-sync-native.ts --resume",
    "ekap:native:full": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx tsx scripts/ekap-sync-native.ts --from=2021 --to=2026",
    "sync:danistay": "npx tsx scripts/sync-danistay.ts --resume",
    "sync:yargitay": "npx tsx scripts/sync-yargitay.ts --resume",
    "sync:uyap": "npx tsx scripts/sync-uyap.ts --resume",
    "sync:kik-kurul": "npx tsx scripts/sync-kik-kurul.ts --resume --headed",
    "sync:kik-kurul:headless": "npx tsx scripts/sync-kik-kurul.ts --resume",
    "sync:all-decisions": "npx tsx scripts/sync-all-decisions.ts --resume",
    "sync:courts": "npx tsx scripts/sync-all-decisions.ts --skip-kik --resume"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@auth/prisma-adapter": "^2.11.1",
    "@aws-sdk/client-s3": "^3.1017.0",
    "@aws-sdk/s3-request-presigner": "^3.1017.0",
    "@azure/msal-node": "^5.1.1",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@google/generative-ai": "^0.24.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@netgsm/sms": "^1.1.11",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@react-pdf/renderer": "^4.3.2",
    "@sentry/nextjs": "^10.46.0",
    "@types/better-sqlite3": "^7.6.13",
    "@upstash/redis": "^1.37.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "googleapis": "^171.4.0",
    "ical-generator": "^10.1.0",
    "inngest": "^4.1.0",
    "isomorphic-dompurify": "^3.7.1",
    "iyzipay": "^2.0.65",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.6.0",
    "next": "16.2.1",
    "next-auth": "^5.0.0-beta.30",
    "openai": "^6.33.0",
    "otpauth": "^9.5.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.9.4",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "prisma": "^7.5.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^4.1.1"
  }
}
