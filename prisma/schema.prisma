generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ─────────────────────────────────────────────────

enum UserRole {
  ADMIN
  PREMIUM
  USER
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum TenderType {
  YAPIM
  MAL_ALIMI
  HIZMET
  DANISMANLIK
}

enum TenderStatus {
  BASVURU_ACIK
  DEGERLENDIRME
  SONUCLANDI
  IPTAL
  YAKLASAN
}

enum ApplicationStatus {
  TASLAK
  GONDERILDI
  DEGERLENDIRMEDE
  KABUL_EDILDI
  REDDEDILDI
  IPTAL
}

enum BidStatus {
  TASLAK
  TAMAMLANDI
  GONDERILDI
}

enum NotificationType {
  YENI_IHALE
  SON_BASVURU
  ZEYILNAME
  SONUC
  SISTEM
}

enum ConversationType {
  GENEL
  IHALE_ANALIZ
  FIYAT_TAHMINI
  RISK_ANALIZI
  SARTNAME_OZETI
  AGENT_AVCI
  SWOT_ANALIZ
  TEKLIF_TASLAK
}

enum AgentTaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum AgentTaskType {
  MATCH_SCAN
  SWOT_ANALYSIS
  BID_DRAFT
  WEEKLY_BRIEFING
  NLP_SEARCH
}

// ─── USER & AUTH ───────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  password      String?
  image         String?
  phone         String?
  role          UserRole  @default(USER)
  plan          SubscriptionPlan @default(FREE)
  companyId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company       Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  accounts      Account[]
  sessions      Session[]
  favorites     Favorite[]
  applications  Application[]
  bids          Bid[]
  notifications    Notification[]
  notificationRules NotificationRule[]
  searchHistory    SearchHistory[]
  aiConversations  AiConversation[]
  pushSubscriptions PushSubscription[]
  activityLogs     ActivityLog[]
  firmProfile      FirmProfile?
  agentTasks       AgentTask[]
  agentResults     AgentResult[]
  bidSimulations     BidSimulation[]
  usageQuotas        UsageQuota[]
  creditTransactions CreditTransaction[]
  trialPeriod        TrialPeriod?
  ownedProjects      Project[]         @relation("ProjectOwner")
  assignedTasks      ProjectTask[]     @relation("TaskAssignee")
  projectComments    ProjectComment[]
  documentVersions   DocumentVersion[]
  signatureRequests  SignatureRequest[] @relation("SignatureSigner")
  approvalSteps      ApprovalWorkflow[] @relation("ApprovalApprover")
  contracts          Contract[]         @relation("ContractOwner")
  supplierRatings    SupplierRating[]   @relation("SupplierRater")
  forumThreads       ForumThread[]      @relation("ThreadAuthor")
  forumReplies       ForumReply[]       @relation("ReplyAuthor")
  wikiEdits          WikiArticle[]      @relation("WikiEditor")
  vendorReviews      VendorReview[]     @relation("VendorReviewer")
  ownedTenants       Tenant[]           @relation("TenantOwner")
  apiKeys            ApiKey[]           @relation("ApiKeyOwner")
  partnerReferrals   PartnerReferral[]  @relation("PartnerUser")
  referredBy         PartnerReferral[]  @relation("ReferredUser")
  securityAuditLogs  SecurityAuditLog[] @relation("AuditUser")
  dataDeletionReqs   DataDeletionRequest[]
  twoFactorAuth      TwoFactorAuth?
  sessions2          UserSession[]      @relation("SessionUser")
  guaranteeRequests  GuaranteeRequest[] @relation("GuaranteeRequester")
  insuranceRequests  InsuranceRequest[] @relation("InsuranceRequester")
  financeLeads       FinanceLeadLog[]   @relation("LeadUser")
  courseProgress     UserCourseProgress[] @relation("CourseStudent")
  certificates       Certificate[]        @relation("CertificateHolder")
  healthQueries      FinancialHealthQuery[] @relation("HealthQueryUser")
  legalAlerts        UserLegalAlert[]       @relation("LegalAlertUser")
  calendarEvents     CalendarEvent[]        @relation("CalendarEventUser")
  calendarSyncs      CalendarSync[]         @relation("CalendarSyncUser")
  smartReminders     SmartReminder[]        @relation("SmartReminderUser")

  @@index([email])
  @@index([companyId])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── COMPANY ───────────────────────────────────────────────

model Company {
  id               String   @id @default(cuid())
  name             String
  taxNumber        String   @unique
  taxOffice        String?
  address          String?
  city             String?
  phone            String?
  email            String?
  website          String?
  sector           String?
  description      String?  @db.Text
  foundedYear      Int?
  employeeCount    Int?
  externalMersisId String?  @unique
  externalKapId    String?
  dunsNumber       String?  @unique
  vknVerified      Boolean  @default(false)
  mersisData       Json?
  capitalAmount    Decimal? @db.Decimal(18, 2)
  companyType      String?
  tradeRegNo       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users       User[]
  bids        Bid[]
  competitors CompetitorProfile[]
  ipWhitelist IpWhitelist[]
  jvRequests  JvRequest[]    @relation("JvRequestCompany")
  jvMatches   JvMatch[]      @relation("JvMatchedCompany")
  jvAgreements JvAgreementParty[] @relation("JvAgreementCompany")
  healthScores     FinancialHealthScore[] @relation("HealthScoreCompany")
  capacityAnalyses CapacityAnalysis[]     @relation("CapacityCompany")
  parasutConnection ParasutConnection?    @relation("ParasutCompany")

  @@index([taxNumber])
  @@index([city])
  @@index([sector])
  @@index([externalMersisId])
}

// ─── TENDER ────────────────────────────────────────────────

model Tender {
  id              String       @id @default(cuid())
  title           String
  institution     String
  city            String
  district        String?
  tenderType      TenderType
  status          TenderStatus @default(BASVURU_ACIK)
  ekapNo          String?      @unique
  ilanNo          String?
  description     String?      @db.Text
  requirements    String?      @db.Text
  estimatedCost   Decimal?     @db.Decimal(18, 2)
  guaranteeRate   Decimal?     @db.Decimal(5, 2)
  publishDate     DateTime     @default(now())
  deadline        DateTime
  openingDate     DateTime?
  latitude        Decimal?     @db.Decimal(10, 7)
  longitude       Decimal?     @db.Decimal(10, 7)
  contactPerson   String?
  contactPhone    String?
  contactEmail    String?
  source          String?      @default("EKAP")
  oksCodes        Json?
  eIhale          Boolean      @default(false)
  foreignAllowed  Boolean      @default(false)
  partialBid      Boolean      @default(false)
  jointPurchase   Boolean      @default(false)
  announcementType String?
  viewCount       Int          @default(0)
  isFeatured      Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  documents       TenderDocument[]
  timeline        TenderTimeline[]
  results         TenderResult[]
  favorites       Favorite[]
  applications    Application[]
  bids            Bid[]
  notifications   Notification[]
  similarFrom     SimilarTender[] @relation("SimilarFrom")
  similarTo       SimilarTender[] @relation("SimilarTo")
  aiSummaries     AiTenderSummary[]
  agentResults    AgentResult[]
  winProbabilities WinProbability[]
  projects         Project[]
  contracts        Contract[]
  jvRequests         JvRequest[]
  guaranteeRequests  GuaranteeRequest[] @relation("GuaranteeTender")
  insuranceRequests  InsuranceRequest[] @relation("InsuranceTender")
  calendarEvents     CalendarEvent[]    @relation("CalendarEventTender")

  @@index([city])
  @@index([tenderType])
  @@index([status])
  @@index([deadline])
  @@index([publishDate])
  @@index([estimatedCost])
  @@index([city, tenderType])
  @@index([status, deadline])
}

model TenderDocument {
  id         String   @id @default(cuid())
  tenderId   String
  name       String
  category   String?
  fileUrl    String?
  fileSize   String?
  mimeType   String?
  uploadedAt DateTime @default(now())

  tender     Tender             @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  versions   DocumentVersion[]
  shareLinks ShareLink[]

  @@index([tenderId])
}

model TenderTimeline {
  id          String   @id @default(cuid())
  tenderId    String
  title       String
  description String?
  date        DateTime
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId])
  @@index([date])
}

model TenderResult {
  id            String   @id @default(cuid())
  tenderId      String
  winnerName    String
  winnerTaxNo   String?
  winnerAmount  Decimal  @db.Decimal(18, 2)
  totalBidders  Int      @default(0)
  resultDate    DateTime
  notes         String?  @db.Text
  createdAt     DateTime @default(now())

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId])
  @@index([winnerName])
}

model SimilarTender {
  id        String @id @default(cuid())
  fromId    String
  toId      String
  score     Float  @default(0)

  fromTender Tender @relation("SimilarFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toTender   Tender @relation("SimilarTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([fromId])
  @@index([toId])
}

// ─── FAVORITES & APPLICATIONS ──────────────────────────────

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  tenderId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@unique([userId, tenderId])
  @@index([userId])
  @@index([tenderId])
}

model Application {
  id        String            @id @default(cuid())
  userId    String
  tenderId  String
  status    ApplicationStatus @default(TASLAK)
  bidAmount Decimal?          @db.Decimal(18, 2)
  notes     String?           @db.Text
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@unique([userId, tenderId])
  @@index([userId])
  @@index([tenderId])
  @@index([status])
}

// ─── BIDS ──────────────────────────────────────────────────

model Bid {
  id          String    @id @default(cuid())
  userId      String
  tenderId    String
  companyId   String?
  status      BidStatus @default(TASLAK)
  totalAmount Decimal?  @db.Decimal(18, 2)
  kdvRate     Decimal   @default(20) @db.Decimal(5, 2)
  notes       String?   @db.Text
  letterContent String? @db.Text
  companyName   String?
  companyTaxNo  String?
  companyAddress String?
  companyPhone  String?
  companyEmail  String?
  contactPerson String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tender  Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items       BidItem[]
  simulations BidSimulation[]

  @@index([userId])
  @@index([tenderId])
  @@index([status])
  @@index([userId, createdAt])
}

model BidItem {
  id          String  @id @default(cuid())
  bidId       String
  description String
  unit        String
  quantity    Decimal @db.Decimal(18, 4)
  unitPrice   Decimal @db.Decimal(18, 2)
  totalPrice  Decimal @db.Decimal(18, 2)
  sortOrder   Int     @default(0)

  bid Bid @relation(fields: [bidId], references: [id], onDelete: Cascade)

  @@index([bidId])
}

// ─── NOTIFICATIONS ─────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  tenderId  String?
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tender Tender? @relation(fields: [tenderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

model NotificationRule {
  id         String       @id @default(cuid())
  userId     String
  name       String
  isActive   Boolean      @default(true)
  cities     String[]
  tenderTypes TenderType[]
  keywords   String[]
  budgetMin  Decimal?     @db.Decimal(18, 2)
  budgetMax  Decimal?     @db.Decimal(18, 2)
  emailNotify Boolean     @default(true)
  pushNotify  Boolean     @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

// ─── COMPETITORS ───────────────────────────────────────────

model CompetitorProfile {
  id           String   @id @default(cuid())
  companyId    String?
  name         String
  taxNumber    String?  @unique
  city         String?
  sector       String?
  totalWins    Int      @default(0)
  totalBids    Int      @default(0)
  totalAmount  Decimal  @default(0) @db.Decimal(18, 2)
  avgBidAmount Decimal  @default(0) @db.Decimal(18, 2)
  winRate      Decimal  @default(0) @db.Decimal(5, 2)
  lastActivity DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  experiences CompetitorExperience[]

  @@index([name])
  @@index([taxNumber])
  @@index([city])
  @@index([sector])
}

model CompetitorExperience {
  id           String   @id @default(cuid())
  competitorId String
  tenderTitle  String
  institution  String
  city         String?
  amount       Decimal  @db.Decimal(18, 2)
  year         Int
  isWon        Boolean  @default(false)

  competitor CompetitorProfile @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId])
  @@index([year])
}

// ─── AI ────────────────────────────────────────────────────

model AiConversation {
  id               String           @id @default(cuid())
  userId           String
  tenderId         String?
  conversationType ConversationType @default(GENEL)
  title            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId])
  @@index([conversationType])
}

model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String   @db.Text
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AiTenderSummary {
  id         String   @id @default(cuid())
  tenderId   String
  summary    String   @db.Text
  keyDates   String?  @db.Text
  risks      String?  @db.Text
  effortLevel String?
  confidence Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId])
}

// ─── SEARCH ────────────────────────────────────────────────

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String
  filters   Json?
  resultCount Int    @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ─── PUSH SUBSCRIPTIONS ───────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── STATS ─────────────────────────────────────────────────

model DailyStats {
  id              String   @id @default(cuid())
  date            DateTime @unique
  totalTenders    Int      @default(0)
  newTenders      Int      @default(0)
  closingTenders  Int      @default(0)
  totalBudget     Decimal  @default(0) @db.Decimal(18, 2)
  avgBudget       Decimal  @default(0) @db.Decimal(18, 2)
  totalUsers      Int      @default(0)
  activeUsers     Int      @default(0)
  totalSearches   Int      @default(0)
  totalPageViews  Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([date])
}

model SectorStats {
  id          String   @id @default(cuid())
  month       String
  sector      String
  tenderCount Int      @default(0)
  totalBudget Decimal  @default(0) @db.Decimal(18, 2)
  avgBudget   Decimal  @default(0) @db.Decimal(18, 2)
  createdAt   DateTime @default(now())

  @@unique([month, sector])
  @@index([month])
}

// ─── EKAP SYNC ─────────────────────────────────────────────

model EkapSyncLog {
  id           String   @id @default(cuid())
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  totalFetched Int      @default(0)
  newRecords   Int      @default(0)
  updatedRecords Int    @default(0)
  errors       Int      @default(0)
  errorDetails String?  @db.Text
  status       String   @default("running")

  @@index([startedAt])
  @@index([status])
}

// ─── ACTIVITY LOG ──────────────────────────────────────────

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([userId, createdAt])
}

// ─── PAYMENTS ──────────────────────────────────────────────

model Payment {
  id               String   @id @default(cuid())
  userId           String
  planId           String
  amount           Decimal  @db.Decimal(18, 2)
  currency         String   @default("TRY")
  status           String   @default("pending") // pending, completed, failed, refunded
  provider         String   @default("iyzico")
  providerTxId     String?
  iyzicoPaymentId  String?
  installmentCount Int?
  cardLastFour     String?
  billingPeriod    String?  // monthly, yearly
  invoiceStatus    String?  // triggered, created, sent, failed
  parasutInvoiceId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([iyzicoPaymentId])
}

model Subscription {
  id                    String    @id @default(cuid())
  userId                String    @unique
  plan                  SubscriptionPlan @default(FREE)
  status                String    @default("active") // active, cancelled, past_due, expired
  startDate             DateTime  @default(now())
  endDate               DateTime?
  cancelledAt           DateTime?
  iyzicoSubscriptionRef String?   // iyzico subscription reference code
  iyzicoCustomerRef     String?   // iyzico customer reference code
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([endDate])
  @@index([iyzicoSubscriptionRef])
}

// ─── AGENTIC AI ─────────────────────────────────────────

model FirmProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  companyName     String
  sectors         String[] // ["Yapım İşleri", "Bilişim"]
  cities          String[] // ["İstanbul", "Ankara"]
  maxBudget       Decimal  @db.Decimal(18, 2)
  minBudget       Decimal  @default(0) @db.Decimal(18, 2)
  preferredTypes  String[] // ["YAPIM", "HIZMET"]
  experienceYears Int      @default(0)
  keywords        String[] // ["altyapı", "beton", "yazılım"]
  embedding       Float[]  // profile embedding vector
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentResults AgentResult[]

  @@index([userId])
  @@index([isActive])
}

model AgentTask {
  id          String          @id @default(cuid())
  userId      String
  type        AgentTaskType
  status      AgentTaskStatus @default(PENDING)
  input       Json?           // task parameters
  output      Json?           // task result summary
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  results AgentResult[]

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model AgentResult {
  id            String   @id @default(cuid())
  taskId        String
  userId        String
  firmProfileId String?
  tenderId      String?
  matchScore    Float?   // 0-100 similarity score
  analysis      Json     // detailed result data
  actionTaken   String?  // e.g., "notification_sent", "bid_draft_created"
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  task        AgentTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  firmProfile FirmProfile? @relation(fields: [firmProfileId], references: [id], onDelete: Cascade)
  tender      Tender?      @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@index([tenderId])
  @@index([matchScore])
  @@index([isRead])
  @@index([createdAt])
}

// ─── SMART BID OPTIMIZATION ─────────────────────────────

model BenchmarkData {
  id          String   @id @default(cuid())
  sector      String   // "Yapım İşleri", "Bilişim" etc.
  unit        String   // "m³", "m²", "ton", "adet" etc.
  itemName    String   // "Beton C30/37", "Demir donatı" etc.
  avgPrice    Decimal  @db.Decimal(18, 2)
  minPrice    Decimal  @db.Decimal(18, 2)
  maxPrice    Decimal  @db.Decimal(18, 2)
  medianPrice Decimal  @db.Decimal(18, 2)
  sampleCount Int      @default(0)
  period      String   // "2025-Q4", "2026-Q1" etc.
  city        String?  // Optional city-specific benchmark
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sector, unit, itemName, period, city])
  @@index([sector])
  @@index([unit, itemName])
  @@index([period])
}

model BidSimulation {
  id          String   @id @default(cuid())
  bidId       String
  userId      String
  scenario    String   // "base", "kdv_dahil", "nakliye_ekle", "kar_marji_5" etc.
  parameters  Json     // { kdvIncluded: true, transportCost: 50000, profitMargin: 5 }
  baseAmount  Decimal  @db.Decimal(18, 2)
  finalAmount Decimal  @db.Decimal(18, 2)
  breakdown   Json     // { kdv: 400000, nakliye: 50000, kar: 100000 }
  createdAt   DateTime @default(now())

  bid  Bid  @relation(fields: [bidId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bidId])
  @@index([userId])
}

model WinProbability {
  id           String   @id @default(cuid())
  tenderId     String
  userId       String?
  bidAmount    Decimal  @db.Decimal(18, 2)
  probability  Float    // 0-100
  competitorEst Int     @default(5)
  analysisData Json     // { historicalWins: [...], marketPosition: "competitive" }
  calculatedAt DateTime @default(now())

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId])
  @@index([bidAmount])
  @@index([calculatedAt])
}

// ─── PREMIUM MONETIZATION ───────────────────────────────

model UsageQuota {
  id        String   @id @default(cuid())
  userId    String
  feature   String   // "tender_view", "favorite", "notification", "bid", "ai_credit", "competitor"
  used      Int      @default(0)
  limit     Int      // -1 = unlimited
  resetAt   DateTime // Monthly reset date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature])
  @@index([userId])
  @@index([feature])
  @@index([resetAt])
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "debit", "credit", "reset", "bonus", "purchase"
  amount      Int      // negative for usage, positive for addition
  balance     Int      // running balance after transaction
  description String
  feature     String?  // "chat", "summary", "estimate", "swot", "bid_draft", "match"
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model TrialPeriod {
  id         String    @id @default(cuid())
  userId     String    @unique
  plan       SubscriptionPlan
  startDate  DateTime  @default(now())
  endDate    DateTime
  converted  Boolean   @default(false)
  cancelledAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([endDate])
  @@index([converted])
}

// ─── PROJECT MANAGEMENT (EK 4) ──────────────────────────

enum ProjectStatus {
  TAKIPTE
  HAZIRLANIYOR
  TEKLIF_VERILDI
  SONUC_BEKLENIYOR
  KAZANDI
  KAYBETTI
}

enum ProjectTaskStatus {
  BEKLIYOR
  DEVAM_EDIYOR
  TAMAMLANDI
}

model Project {
  id        String        @id @default(cuid())
  tenderId  String
  ownerId   String
  status    ProjectStatus @default(TAKIPTE)
  title     String?
  notes     String?       @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tender    Tender           @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  owner     User             @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  tasks     ProjectTask[]
  comments  ProjectComment[]
  approvals ApprovalWorkflow[]

  @@unique([tenderId, ownerId])
  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
}

model ProjectTask {
  id          String            @id @default(cuid())
  projectId   String
  assigneeId  String?
  title       String
  description String?           @db.Text
  status      ProjectTaskStatus @default(BEKLIYOR)
  dueDate     DateTime?
  sortOrder   Int               @default(0)
  category    String?           // "dokuman", "maliyet", "teknik", "teklif", "onay", "gonderim"
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?                @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  attachments ProjectAttachment[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
  @@index([projectId, sortOrder])
}

model ProjectComment {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
}

model ProjectAttachment {
  id         String   @id @default(cuid())
  taskId     String
  fileUrl    String
  fileName   String
  fileSize   Int?
  mimeType   String?
  uploadedAt DateTime @default(now())

  task ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ─── E-SIGNATURE & DOCUMENT MANAGEMENT (EK 5) ──────────

enum SignatureStatus {
  BEKLIYOR
  IMZALANDI
  REDDEDILDI
  IPTAL
}

enum ApprovalStatus {
  BEKLIYOR
  ONAYLANDI
  REDDEDILDI
  ATLANDI
}

model DocumentVersion {
  id            String   @id @default(cuid())
  documentId    String   // TenderDocument id
  version       Int
  fileUrl       String
  fileName      String
  fileSize      Int?
  mimeType      String?
  changeSummary String?  @db.Text
  ocrText       String?  @db.Text
  createdById   String
  createdAt     DateTime @default(now())

  document  TenderDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy User               @relation(fields: [createdById], references: [id], onDelete: Cascade)
  signatures SignatureRequest[]

  @@unique([documentId, version])
  @@index([documentId])
  @@index([createdById])
  @@index([createdAt])
}

model SignatureRequest {
  id            String          @id @default(cuid())
  versionId     String
  signerId      String
  status        SignatureStatus @default(BEKLIYOR)
  method        String?         // "e_devlet", "turkcell_e_imza", "mobil_imza"
  certificateId String?
  signedAt      DateTime?
  rejectedAt    DateTime?
  reason        String?
  createdAt     DateTime        @default(now())

  version DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  signer  User            @relation("SignatureSigner", fields: [signerId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@index([signerId])
  @@index([status])
}

model ApprovalWorkflow {
  id         String         @id @default(cuid())
  projectId  String
  step       Int            // 1 = Dept Manager, 2 = GM, 3 = Send
  stepTitle  String         // "Departman Müdürü Onayı", "Genel Müdür Onayı", "Gönderim"
  approverId String
  status     ApprovalStatus @default(BEKLIYOR)
  comment    String?        @db.Text
  decidedAt  DateTime?
  createdAt  DateTime       @default(now())

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approver User    @relation("ApprovalApprover", fields: [approverId], references: [id], onDelete: Cascade)

  @@unique([projectId, step])
  @@index([projectId])
  @@index([approverId])
  @@index([status])
}

model ShareLink {
  id          String    @id @default(cuid())
  documentId  String
  token       String    @unique @default(cuid())
  expiresAt   DateTime
  maxDownloads Int      @default(1)
  downloadCount Int     @default(0)
  createdById String
  createdAt   DateTime  @default(now())

  document TenderDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([documentId])
  @@index([expiresAt])
}

// ─── MARKET INTELLIGENCE (EK 6) ────────────────────────

model MarketReport {
  id          String   @id @default(cuid())
  period      String   // "2026-Q1", "2026-03", "2026-W12"
  periodType  String   // "weekly", "monthly", "quarterly"
  sector      String?  // null = all sectors
  city        String?  // null = all cities
  metrics     Json     // { tenderCount, totalBudget, avgBudget, growthRate, ... }
  highlights  Json?    // [{ title, value, change }]
  generatedAt DateTime @default(now())

  @@unique([period, sector, city])
  @@index([period])
  @@index([sector])
  @@index([city])
  @@index([generatedAt])
}

model PriceIndex {
  id       String   @id @default(cuid())
  sector   String   // "Yapım İşleri", "Bilişim"
  item     String   // "Beton C30/37", "Betonarme demiri"
  unit     String   // "m³", "ton", "adet"
  price    Decimal  @db.Decimal(18, 2)
  prevPrice Decimal? @db.Decimal(18, 2) // previous month price
  change   Float?   // percentage change
  month    String   // "2026-03"
  source   String?  // "Çevre ve Şehircilik Bakanlığı", "Piyasa Ortalaması"
  createdAt DateTime @default(now())

  @@unique([sector, item, month])
  @@index([sector])
  @@index([item])
  @@index([month])
}

model CompetitionDensity {
  id          String   @id @default(cuid())
  city        String
  sector      String
  avgBidders  Float    // average number of bidders
  winRate     Float    // average win rate percentage
  totalTenders Int     @default(0)
  totalBudget Decimal  @default(0) @db.Decimal(18, 2)
  period      String   // "2026-Q1"
  updatedAt   DateTime @default(now())

  @@unique([city, sector, period])
  @@index([city])
  @@index([sector])
  @@index([period])
}

// ─── CONTRACT & PERFORMANCE MANAGEMENT (EK 7) ──────────

enum ContractStatus {
  TASLAK
  AKTIF
  DEVAM_EDIYOR
  TAMAMLANDI
  FESHEDILDI
  ASKIYA_ALINDI
}

enum PaymentStatus {
  HAZIRLANIYOR
  ONAY_BEKLIYOR
  ONAYLANDI
  ODENDI
  REDDEDILDI
}

enum GuaranteeType {
  GECICI_TEMINAT
  KESIN_TEMINAT
  AVANS_TEMINAT
  EK_KESIN_TEMINAT
}

enum GuaranteeStatus {
  AKTIF
  IADE_EDILDI
  NAKDE_CEVRILDI
  SURESI_DOLDU
}

model Contract {
  id              String         @id @default(cuid())
  tenderId        String
  userId          String
  contractNo      String?        @unique
  title           String
  status          ContractStatus @default(TASLAK)
  contractDate    DateTime
  startDate       DateTime
  endDate         DateTime
  totalAmount     Decimal        @db.Decimal(18, 2)
  kdvRate         Decimal        @default(20) @db.Decimal(5, 2)
  advanceRate     Decimal?       @db.Decimal(5, 2)
  penaltyRate     Decimal?       @db.Decimal(5, 2)    // daily penalty rate
  penaltyDetails  String?        @db.Text
  warrantyMonths  Int            @default(12)
  notes           String?        @db.Text
  completionRate  Float          @default(0)           // 0-100
  paidAmount      Decimal        @default(0) @db.Decimal(18, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tender          Tender           @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  user            User             @relation("ContractOwner", fields: [userId], references: [id], onDelete: Cascade)
  payments        ProgressPayment[]
  workProgress    WorkProgress[]
  guarantees      Guarantee[]

  @@index([tenderId])
  @@index([userId])
  @@index([status])
  @@index([endDate])
  @@index([createdAt])
}

model ProgressPayment {
  id              String        @id @default(cuid())
  contractId      String
  periodNo        Int           // hakediş no: 1, 2, 3...
  periodStart     DateTime
  periodEnd       DateTime
  description     String?       @db.Text
  grossAmount     Decimal       @db.Decimal(18, 2)
  deductions      Decimal       @default(0) @db.Decimal(18, 2)  // kesintiler
  netAmount       Decimal       @db.Decimal(18, 2)
  cumulativeRate  Float         @default(0)   // cumulative completion %
  status          PaymentStatus @default(HAZIRLANIYOR)
  submittedAt     DateTime?
  approvedAt      DateTime?
  paidAt          DateTime?
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, periodNo])
  @@index([contractId])
  @@index([status])
  @@index([createdAt])
}

model WorkProgress {
  id              String   @id @default(cuid())
  contractId      String
  title           String
  description     String?  @db.Text
  completionRate  Float    @default(0)   // 0-100
  isMilestone     Boolean  @default(false)
  milestoneDate   DateTime?
  photos          Json?    // [{ url, caption, uploadedAt }]
  reportDate      DateTime @default(now())
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([isMilestone])
  @@index([reportDate])
}

model SupplierRating {
  id              String   @id @default(cuid())
  userId          String
  supplierName    String
  supplierTaxNo   String?
  contractTitle   String?
  deliveryScore   Float    @default(0)   // 1-5
  qualityScore    Float    @default(0)   // 1-5
  communicationScore Float @default(0)   // 1-5
  priceScore      Float    @default(0)   // 1-5
  overallScore    Float    @default(0)   // average
  comment         String?  @db.Text
  ratingDate      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation("SupplierRater", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, supplierName, contractTitle])
  @@index([userId])
  @@index([supplierName])
  @@index([overallScore])
}

model Guarantee {
  id              String          @id @default(cuid())
  contractId      String
  type            GuaranteeType
  status          GuaranteeStatus @default(AKTIF)
  bankName        String
  letterNo        String?
  amount          Decimal         @db.Decimal(18, 2)
  issueDate       DateTime
  expiryDate      DateTime
  returnDate      DateTime?
  notes           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([type])
  @@index([status])
  @@index([expiryDate])
}

// ─── COMMUNITY & KNOWLEDGE PLATFORM (EK 8) ─────────────

model ForumCategory {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  slug        String   @unique
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  threads ForumThread[]

  @@index([slug])
  @@index([sortOrder])
}

model ForumThread {
  id          String   @id @default(cuid())
  categoryId  String
  authorId    String
  title       String
  content     String   @db.Text
  isPinned    Boolean  @default(false)
  isLocked    Boolean  @default(false)
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  author   User          @relation("ThreadAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  replies  ForumReply[]

  @@index([categoryId])
  @@index([authorId])
  @@index([isPinned])
  @@index([createdAt])
  @@index([viewCount])
}

model ForumReply {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String
  content   String   @db.Text
  upvotes   Int      @default(0)
  isAnswer  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User        @relation("ReplyAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([authorId])
  @@index([upvotes])
  @@index([createdAt])
}

model WikiArticle {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  content      String   @db.Text
  summary      String?  @db.Text
  category     String?  // "genel", "mevzuat", "hesaplama", "süreç"
  tags         String[] // ["teminat", "zeyilname", "iş deneyim"]
  version      Int      @default(1)
  lastEditedBy String
  viewCount    Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  editor User @relation("WikiEditor", fields: [lastEditedBy], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([category])
  @@index([lastEditedBy])
  @@index([viewCount])
  @@index([createdAt])
}

model VendorReview {
  id          String   @id @default(cuid())
  vendorName  String
  vendorTaxNo String?
  reviewerId  String
  rating      Float    // 1-5
  workQuality Float?   // 1-5
  timeliness  Float?   // 1-5
  communication Float? // 1-5
  pricePerformance Float? // 1-5
  comment     String?  @db.Text
  projectType String?  // "Yapım", "Hizmet", "Mal Alımı"
  isAnonymous Boolean  @default(true)
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviewer User @relation("VendorReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([vendorName])
  @@index([vendorTaxNo])
  @@index([reviewerId])
  @@index([rating])
  @@index([createdAt])
}

// ─── WHITE-LABEL & API MARKETPLACE (EK 9) ───────────────

enum TenantPlan {
  STARTER
  BUSINESS
  ENTERPRISE
}

enum ReferralStatus {
  BEKLIYOR
  ONAYLANDI
  ODENDI
  IPTAL
}

model Tenant {
  id           String     @id @default(cuid())
  ownerId      String
  name         String
  slug         String     @unique  // subdomain: tenant.ihalepro.com
  customDomain String?    @unique
  logo         String?
  favicon      String?
  primaryColor String     @default("#1a56db")
  secondaryColor String?
  plan         TenantPlan @default(STARTER)
  isActive     Boolean    @default(true)
  settings     Json?      // { footerText, headerText, contactEmail, ... }
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  owner    User      @relation("TenantOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  apiKeys  ApiKey[]
  webhooks Webhook[]

  @@index([ownerId])
  @@index([slug])
  @@index([customDomain])
  @@index([isActive])
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  tenantId    String?
  name        String
  key         String    @unique  // hashed key
  prefix      String    // first 8 chars visible: "ihp_xxxx..."
  permissions String[]  // ["tenders:read", "tenders:search", "bids:write"]
  rateLimit   Int       @default(1000) // requests per hour
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  user   User    @relation("ApiKeyOwner", fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  usage  ApiUsage[]

  @@index([userId])
  @@index([tenantId])
  @@index([key])
  @@index([prefix])
  @@index([isActive])
}

model ApiUsage {
  id           String   @id @default(cuid())
  apiKeyId     String
  endpoint     String
  method       String   // GET, POST, etc.
  statusCode   Int
  responseTime Int      // milliseconds
  requestBody  String?  @db.Text
  ipAddress    String?
  userAgent    String?
  date         DateTime @default(now())

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([endpoint])
  @@index([date])
  @@index([apiKeyId, date])
  @@index([statusCode])
}

model Webhook {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  url       String
  events    String[] // ["tender.created", "tender.updated", "result.announced"]
  secret    String   // HMAC signing secret
  isActive  Boolean  @default(true)
  lastSentAt DateTime?
  failCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([isActive])
  @@index([events])
}

model PartnerReferral {
  id             String         @id @default(cuid())
  partnerId      String         // the partner who referred
  referredUserId String?        // the user who signed up
  referralCode   String         @unique
  commission     Decimal        @default(0) @db.Decimal(18, 2)
  commissionRate Decimal        @default(10) @db.Decimal(5, 2) // percentage
  status         ReferralStatus @default(BEKLIYOR)
  paidAt         DateTime?
  notes          String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  partner      User  @relation("PartnerUser", fields: [partnerId], references: [id], onDelete: Cascade)
  referredUser User? @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([referredUserId])
  @@index([referralCode])
  @@index([status])
}

// ─── SECURITY, AUDIT & COMPLIANCE (EK 10) ───────────────

enum DeletionStatus {
  TALEP_EDILDI
  ISLENIYOR
  TAMAMLANDI
  REDDEDILDI
}

model SecurityAuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // "user.login", "tender.create", "bid.update", "settings.change"
  entityType String?  // "User", "Tender", "Bid", "Contract"
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  severity   String   @default("info") // "info", "warning", "critical"
  metadata   Json?    // extra context
  createdAt  DateTime @default(now())

  user User? @relation("AuditUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([severity])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model DataDeletionRequest {
  id          String         @id @default(cuid())
  userId      String
  status      DeletionStatus @default(TALEP_EDILDI)
  reason      String?        @db.Text
  dataTypes   String[]       // ["profil", "teklifler", "mesajlar", "arama_gecmisi"]
  requestedAt DateTime       @default(now())
  processedAt DateTime?
  completedAt DateTime?
  notes       String?        @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([requestedAt])
}

model TwoFactorAuth {
  id          String   @id @default(cuid())
  userId      String   @unique
  secret      String   // TOTP secret (encrypted)
  isEnabled   Boolean  @default(false)
  backupCodes String[] // hashed backup codes
  verifiedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model IpWhitelist {
  id          String   @id @default(cuid())
  companyId   String
  ipRange     String   // "192.168.1.0/24" or single IP
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([isActive])
}

model RolePermission {
  id        String  @id @default(cuid())
  role      String  // "ADMIN", "PREMIUM", "USER", "VIEWER"
  resource  String  // "tenders", "bids", "contracts", "reports", "settings"
  action    String  // "read", "create", "update", "delete", "approve"
  isAllowed Boolean @default(true)

  @@unique([role, resource, action])
  @@index([role])
  @@index([resource])
}

model UserSession {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  ipAddress  String?
  userAgent  String?
  device     String?   // "Chrome on Windows", "Safari on iPhone"
  location   String?   // "İstanbul, TR"
  isActive   Boolean   @default(true)
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  user User @relation("SessionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([isActive])
  @@index([lastSeenAt])
}

// ─── İŞ ORTAKLIĞI EŞLEŞTİRME (JV MATCHING) ────────────────

enum JvRequestStatus {
  OPEN
  MATCHED
  CLOSED
}

enum JvMatchStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model JvRequest {
  id                       String          @id @default(cuid())
  companyId                String
  tenderId                 String?
  title                    String
  description              String          @db.Text
  requiredSpecialty         String          // "YAPIM", "HIZMET", etc.
  requiredExperienceAmount Decimal         @db.Decimal(18, 2)
  city                     String
  status                   JvRequestStatus @default(OPEN)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  company   Company    @relation("JvRequestCompany", fields: [companyId], references: [id], onDelete: Cascade)
  tender    Tender?    @relation(fields: [tenderId], references: [id], onDelete: SetNull)
  matches   JvMatch[]
  agreement JvAgreement?

  @@index([companyId])
  @@index([tenderId])
  @@index([status])
  @@index([city])
  @@index([requiredSpecialty])
}

model JvMatch {
  id                 String        @id @default(cuid())
  requestId          String
  matchedCompanyId   String
  compatibilityScore Float
  status             JvMatchStatus @default(PENDING)
  message            String?       @db.Text
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  request        JvRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  matchedCompany Company   @relation("JvMatchedCompany", fields: [matchedCompanyId], references: [id], onDelete: Cascade)

  @@unique([requestId, matchedCompanyId])
  @@index([requestId])
  @@index([matchedCompanyId])
  @@index([status])
}

model JvAgreement {
  id            String   @id @default(cuid())
  requestId     String   @unique
  agreementType String   // "ADI_ORTAKLIK", "KONSORSIYUM"
  ndaSignedAt   DateTime?
  templateUrl   String?
  terms         Json?    // NDA template as JSON
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  request JvRequest          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  parties JvAgreementParty[]
}

model JvAgreementParty {
  id          String @id @default(cuid())
  agreementId String
  companyId   String
  role        String // "PILOT_ORTAK", "OZEL_ORTAK"
  sharePercent Float  @default(50)

  agreement JvAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  company   Company     @relation("JvAgreementCompany", fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([agreementId, companyId])
  @@index([agreementId])
  @@index([companyId])
}

// ─── TEMİNAT MEKTUBU & SİGORTA MARKETPLACE ─────────────────

enum GuaranteeRequestType {
  GECICI
  KESIN
  AVANS
}

enum FinanceRequestStatus {
  BEKLEMEDE
  TEKLIFLER_ALINDI
  ONAYLANDI
  REDDEDILDI
  IPTAL
}

enum InsuranceType {
  MESLEKI
  ALL_RISK
  ISG
}

enum FinancialPartnerType {
  BANKA
  SIGORTA
}

model GuaranteeRequest {
  id          String               @id @default(cuid())
  userId      String
  tenderId    String?
  type        GuaranteeRequestType
  amount      Decimal              @db.Decimal(18, 2)
  duration    Int                  // gün
  description String?              @db.Text
  status      FinanceRequestStatus @default(BEKLEMEDE)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user   User    @relation("GuaranteeRequester", fields: [userId], references: [id], onDelete: Cascade)
  tender Tender? @relation("GuaranteeTender", fields: [tenderId], references: [id], onDelete: SetNull)
  offers GuaranteeOffer[]

  @@index([userId])
  @@index([tenderId])
  @@index([status])
  @@index([type])
}

model GuaranteeOffer {
  id             String   @id @default(cuid())
  requestId      String
  providerId     String?
  providerName   String
  interestRate   Float    // yıllık faiz oranı %
  commission     Decimal  @db.Decimal(18, 2)
  processingDays Int
  totalCost      Decimal  @db.Decimal(18, 2)
  notes          String?  @db.Text
  expiresAt      DateTime
  isSelected     Boolean  @default(false)
  createdAt      DateTime @default(now())

  request  GuaranteeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider FinancialPartner? @relation("GuaranteeProvider", fields: [providerId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([providerId])
}

model InsuranceRequest {
  id             String               @id @default(cuid())
  userId         String
  tenderId       String?
  type           InsuranceType
  coverageAmount Decimal              @db.Decimal(18, 2)
  duration       Int                  // ay
  description    String?              @db.Text
  status         FinanceRequestStatus @default(BEKLEMEDE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user   User    @relation("InsuranceRequester", fields: [userId], references: [id], onDelete: Cascade)
  tender Tender? @relation("InsuranceTender", fields: [tenderId], references: [id], onDelete: SetNull)
  offers InsuranceOffer[]

  @@index([userId])
  @@index([tenderId])
  @@index([status])
  @@index([type])
}

model InsuranceOffer {
  id              String   @id @default(cuid())
  requestId       String
  providerId      String?
  providerName    String
  premium         Decimal  @db.Decimal(18, 2) // yıllık prim
  deductible      Decimal  @db.Decimal(18, 2) // muafiyet
  coverageDetails Json?
  processingDays  Int      @default(3)
  notes           String?  @db.Text
  expiresAt       DateTime
  isSelected      Boolean  @default(false)
  createdAt       DateTime @default(now())

  request  InsuranceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider FinancialPartner? @relation("InsuranceProvider", fields: [providerId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([providerId])
}

model FinancialPartner {
  id             String               @id @default(cuid())
  name           String
  type           FinancialPartnerType
  logoUrl        String?
  contactEmail   String?
  contactPhone   String?
  website        String?
  webhookUrl     String?              // gerçek entegrasyon için
  isActive       Boolean              @default(true)
  commissionRate Float                @default(0)
  description    String?              @db.Text
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  guaranteeOffers GuaranteeOffer[] @relation("GuaranteeProvider")
  insuranceOffers InsuranceOffer[] @relation("InsuranceProvider")
  leadLogs        FinanceLeadLog[] @relation("LeadPartner")

  @@index([type])
  @@index([isActive])
}

model FinanceLeadLog {
  id         String   @id @default(cuid())
  userId     String
  partnerId  String
  offerType  String   // "GUARANTEE" | "INSURANCE"
  offerId    String
  amount     Decimal  @db.Decimal(18, 2)
  status     String   @default("YENI") // YENI, ILETILDI, DONUSUM
  createdAt  DateTime @default(now())

  user    User             @relation("LeadUser", fields: [userId], references: [id], onDelete: Cascade)
  partner FinancialPartner @relation("LeadPartner", fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([partnerId])
  @@index([offerType])
}

// ─── İHALE AKADEMİSİ (E-ÖĞRENİM) ──────────────────────────

enum CourseDifficulty {
  BASLANGIC
  ORTA
  ILERI
  UZMAN
}

model Course {
  id              String           @id @default(cuid())
  title           String
  slug            String           @unique
  description     String           @db.Text
  thumbnailUrl    String?
  category        String           // "MEVZUAT", "EKAP", "TEKLIF", "SOZLESME", "FINANS"
  difficulty      CourseDifficulty @default(BASLANGIC)
  durationMinutes Int              @default(0)
  isPremium       Boolean          @default(false)
  price           Decimal?         @db.Decimal(10, 2)
  order           Int              @default(0)
  isPublished     Boolean          @default(true)
  instructorName  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  lessons  Lesson[]
  progress UserCourseProgress[]
  certificates Certificate[]

  @@index([slug])
  @@index([category])
  @@index([difficulty])
  @@index([isPublished])
}

model Lesson {
  id              String  @id @default(cuid())
  courseId         String
  title           String
  slug            String
  content         String  @db.Text
  videoUrl        String?
  durationMinutes Int     @default(0)
  order           Int     @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quiz   Quiz?

  @@unique([courseId, slug])
  @@index([courseId])
  @@index([order])
}

model Quiz {
  id        String @id @default(cuid())
  lessonId  String @unique
  questions Json   // [{ question, options: string[], correctIndex, explanation }]
  passingScore Int @default(70)
  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model UserCourseProgress {
  id               String    @id @default(cuid())
  userId           String
  courseId          String
  completedLessons String[]  // lesson IDs
  quizScores       Json?     // { lessonId: score }
  completedAt      DateTime?
  certificateId    String?
  startedAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user   User   @relation("CourseStudent", fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model Certificate {
  id                String   @id @default(cuid())
  userId            String
  courseId           String
  certificateNumber String   @unique // "CERT-2026-XXXXX"
  issuedAt          DateTime @default(now())
  verificationUrl   String?

  user   User   @relation("CertificateHolder", fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@index([certificateNumber])
}

// ─── İHALE FİYAT ENDEKSİ ───────────────────────────────────

enum PricePeriod {
  MONTHLY
  QUARTERLY
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum LegalSource {
  RESMI_GAZETE
  KIK
  MEVZUAT_GOV
}

enum LegalCategory {
  KANUN
  YONETMELIK
  TEBLIG
  DUYURU
}

enum ImpactLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IntTenderStatus {
  OPEN
  CLOSING_SOON
  CLOSED
  AWARDED
}

enum CalendarEventType {
  SON_BASVURU
  SORU_TARIHI
  ACIKLAMA
  ZEYILNAME
  OZEL
}

enum CalendarProvider {
  GOOGLE
  OUTLOOK
}

enum ReminderChannel {
  PUSH
  EMAIL
  IN_APP
}

model UnitPriceIndex {
  id          String   @id @default(cuid())
  sector      String   // "YAPIM", "HIZMET", "MAL_ALIMI"
  item        String   // "beton-c30", "demir-celik" vb.
  itemLabel   String   // "Beton C30", "Demir Çelik" (görüntüleme)
  unit        String   // "m³", "ton", "m²", "adet", "gün"
  avgPrice    Decimal  @db.Decimal(18, 2)
  minPrice    Decimal  @db.Decimal(18, 2)
  maxPrice    Decimal  @db.Decimal(18, 2)
  sampleCount Int      @default(0)
  city        String?
  month       DateTime @db.Date
  source      String   @default("IHALE_SONUC") // "IHALE_SONUC", "PIYASA", "KIK"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sector, item, city, month])
  @@index([sector])
  @@index([item])
  @@index([city])
  @@index([month])
}

model UnitPriceTrend {
  id        String      @id @default(cuid())
  sector    String
  item      String
  itemLabel String
  prices    Json        // [{ month, avg, min, max, sampleCount }]
  period    PricePeriod @default(MONTHLY)
  updatedAt DateTime    @updatedAt

  @@unique([sector, item, period])
  @@index([sector])
  @@index([item])
}

model RegionalPriceComparison {
  id          String   @id @default(cuid())
  item        String   @unique
  itemLabel   String
  sector      String
  unit        String
  comparisons Json     // [{ city, avg, min, max, sampleCount }]
  updatedAt   DateTime @updatedAt

  @@index([sector])
  @@index([item])
}

// ─── MACRO PRICE INDEX (TÜİK, Yİ-ÜFE, TÜFE) ──────────────

model MacroPriceIndex {
  id         String   @id @default(cuid())
  code       String   // "YIUFE", "TUFE", "INSAAT_MALIYET", "INSAAT_ISCILIK", "INSAAT_MALZEME"
  name       String
  value      Float
  baseYear   Int      @default(2015)
  period     String   // "2026-03" (YYYY-MM)
  changeMonthly Float? // month-over-month %
  changeYearly  Float? // year-over-year %
  source     String   @default("TUIK")
  createdAt  DateTime @default(now())

  @@unique([code, period])
  @@index([code])
  @@index([period])
  @@index([source])
}

model MinistryUnitPrice {
  id         String   @id @default(cuid())
  code       String   // "15.140/1", "04.743/3"
  name       String
  unit       String   // "m³", "ton", "m²", "adet"
  price      Decimal  @db.Decimal(18, 2)
  year       Int
  month      Int      @default(0) // 0 for annual, 1-12 for monthly
  category   String   // "INSAAT", "MEKANIK", "ELEKTRIK", "ALTYAPI"
  source     String   // "CSB_YFK", "ILLER_BANKASI", "IMO"
  region     String?
  createdAt  DateTime @default(now())

  @@unique([code, year, month, source])
  @@index([code])
  @@index([category])
  @@index([source])
  @@index([year])
}

model CommodityPrice {
  id         String   @id @default(cuid())
  code       String
  name       String
  price      Decimal  @db.Decimal(18, 2)
  unit       String   // "ton", "kg", "litre"
  city       String   @default("")
  exchange   String?  // TOBB borsa adı
  date       DateTime @db.Date
  source     String   @default("TOBB")
  createdAt  DateTime @default(now())

  @@unique([code, city, date, source])
  @@index([code])
  @@index([date])
  @@index([city])
}

// ─── FINANCIAL HEALTH SCORE ─────────────────────────────────

model FinancialHealthScore {
  id             String    @id @default(cuid())
  companyId      String?
  competitorId   String?
  targetName     String
  targetTaxNumber String?
  overallScore   Int       // 0-100
  subscores      Json      // { tenderHistory, paymentHistory, debtRatio, capacityScore, sectorExperience }
  riskLevel      RiskLevel
  sectorBenchmark Int?     // sector average score
  calculatedAt   DateTime  @default(now())
  validUntil     DateTime

  company    Company? @relation("HealthScoreCompany", fields: [companyId], references: [id], onDelete: SetNull)
  queries    FinancialHealthQuery[] @relation("HealthScoreQueries")

  @@index([companyId])
  @@index([competitorId])
  @@index([targetTaxNumber])
  @@index([validUntil])
}

model FinancialHealthQuery {
  id                String   @id @default(cuid())
  userId            String
  targetCompanyName String
  targetTaxNumber   String?
  resultScoreId     String?
  queriedAt         DateTime @default(now())

  user        User                  @relation("HealthQueryUser", fields: [userId], references: [id], onDelete: Cascade)
  resultScore FinancialHealthScore? @relation("HealthScoreQueries", fields: [resultScoreId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([targetTaxNumber])
}

model CapacityAnalysis {
  id                 String   @id @default(cuid())
  companyId          String
  activeTenders      Int      @default(0)
  totalCommitment    Decimal  @default(0) @db.Decimal(18, 2)
  estimatedCapacity  Decimal  @default(0) @db.Decimal(18, 2)
  utilizationPercent Float    @default(0)
  analyzedAt         DateTime @default(now())

  company Company @relation("CapacityCompany", fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([analyzedAt])
}

// ─── LEGAL RADAR ────────────────────────────────────────────

model LegalUpdate {
  id          String        @id @default(cuid())
  title       String
  source      LegalSource
  category    LegalCategory
  summary     String        @db.Text
  aiSummary   String?       @db.Text
  impactLevel ImpactLevel   @default(MEDIUM)
  originalUrl String
  publishDate DateTime
  rawContent  String?       @db.Text
  createdAt   DateTime      @default(now())

  diffs LegalUpdateDiff[] @relation("UpdateDiffs")

  @@index([source])
  @@index([category])
  @@index([impactLevel])
  @@index([publishDate])
}

model LegalUpdateDiff {
  id              String @id @default(cuid())
  updateId        String
  oldText         String? @db.Text
  newText         String? @db.Text
  changedSections Json    // [{ section, type: "added"|"removed"|"modified", content }]

  update LegalUpdate @relation("UpdateDiffs", fields: [updateId], references: [id], onDelete: Cascade)

  @@index([updateId])
}

model UserLegalAlert {
  id           String   @id @default(cuid())
  userId       String
  categories   String[] // LegalCategory values
  impactLevels String[] // ImpactLevel values
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation("LegalAlertUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId])
}

// ─── INTERNATIONAL TENDER PORTAL ────────────────────────────

model InternationalTender {
  id                  String          @id @default(cuid())
  externalId          String?         @unique
  title               String
  titleTr             String?
  country             String
  city                String?
  sector              String
  estimatedBudget     Decimal?        @db.Decimal(18, 2)
  estimatedBudgetTry  Decimal?        @db.Decimal(18, 2)
  currency            String          @default("USD")
  description         String          @db.Text
  descriptionTr       String?         @db.Text
  applicationDeadline DateTime
  sourceUrl           String
  sourcePlatform      String
  cpvCodes            Json?
  buyerName           String?
  buyerCountry        String?
  noticeType          String?
  languageCode        String?         @default("EN")
  status              IntTenderStatus @default(OPEN)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([country])
  @@index([sector])
  @@index([status])
  @@index([applicationDeadline])
  @@index([sourcePlatform])
  @@index([externalId])
}

model CountryProfile {
  id                 String   @id @default(cuid())
  countryCode        String   @unique
  name               String
  nameTr             String
  riskScore          Int      @default(50) // 0-100 (100 = safest)
  paymentReliability String?
  legalFramework     String?  @db.Text
  visaRequirements   String?  @db.Text
  activeProjectCount Int      @default(0)
  flagUrl            String?
  currency           String?
  timezone           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  riskIndicators CountryRiskIndicator[] @relation("CountryRisks")

  @@index([countryCode])
  @@index([riskScore])
}

model CountryRiskIndicator {
  id          String   @id @default(cuid())
  countryId   String
  indicator   String   // political_stability, payment_risk, currency_risk, legal_risk, security_risk
  value       Int      @default(50) // 0-100
  lastUpdated DateTime @default(now())

  country CountryProfile @relation("CountryRisks", fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId, indicator])
  @@index([countryId])
}

// ─── CALENDAR & REMINDERS ───────────────────────────────────

model CalendarEvent {
  id              String            @id @default(cuid())
  userId          String
  tenderId        String?
  title           String
  description     String?           @db.Text
  eventType       CalendarEventType @default(OZEL)
  startDate       DateTime
  endDate         DateTime?
  reminderDays    Int[]             // days before event to remind
  isAutoGenerated Boolean           @default(false)
  externalId      String?           // Google Calendar event ID
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user      User           @relation("CalendarEventUser", fields: [userId], references: [id], onDelete: Cascade)
  tender    Tender?        @relation("CalendarEventTender", fields: [tenderId], references: [id], onDelete: SetNull)
  reminders SmartReminder[] @relation("ReminderEvent")

  @@index([userId])
  @@index([tenderId])
  @@index([startDate])
  @@index([eventType])
  @@index([userId, startDate])
}

model CalendarSync {
  id           String           @id @default(cuid())
  userId       String
  provider     CalendarProvider
  accessToken  String?          @db.Text
  refreshToken String?          @db.Text
  syncEnabled  Boolean          @default(true)
  lastSyncAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user User @relation("CalendarSyncUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

model SmartReminder {
  id          String          @id @default(cuid())
  userId      String
  eventId     String
  message     String          @db.Text
  scheduledAt DateTime
  sentAt      DateTime?
  channel     ReminderChannel @default(IN_APP)
  aiGenerated Boolean         @default(false)
  createdAt   DateTime        @default(now())

  user  User          @relation("SmartReminderUser", fields: [userId], references: [id], onDelete: Cascade)
  event CalendarEvent @relation("ReminderEvent", fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
  @@index([scheduledAt])
  @@index([sentAt])
}

// ─── PARASUT OAUTH CONNECTION ────────────────────────────────

model ParasutConnection {
  id            String   @id @default(cuid())
  companyId     String   @unique
  accessToken   String   @db.Text
  refreshToken  String   @db.Text
  tokenExpiresAt DateTime
  parasutCompanyId String
  lastSyncAt    DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation("ParasutCompany", fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ─── EXTERNAL DATA PROVIDER CACHE & SYNC ────────────────────

enum SyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model CachedData {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  provider  String
  ttl       Int
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([provider, key])
  @@index([expiresAt])
}

model DataSyncLog {
  id           String      @id @default(cuid())
  provider     String
  operation    String
  status       SyncStatus
  recordCount  Int         @default(0)
  errorMessage String?
  startedAt    DateTime
  completedAt  DateTime?

  @@index([provider, status])
}
